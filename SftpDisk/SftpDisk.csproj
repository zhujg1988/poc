<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SftpDisk</AssemblyName>
    <RootNamespace>SftpDisk</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    WinFSP must be installed on the build machine.
    Common installation paths (adjust if needed):
      C:\Program Files (x86)\WinFsp\bin\WinFsp-MSIL.dll
      C:\Program Files\WinFsp\bin\WinFsp-MSIL.dll
  -->
  <PropertyGroup>
    <WinFspMsilDll Condition="Exists('C:\Program Files (x86)\WinFsp\bin\WinFsp-MSIL.dll')">C:\Program Files (x86)\WinFsp\bin\WinFsp-MSIL.dll</WinFspMsilDll>
    <WinFspMsilDll Condition="'$(WinFspMsilDll)' == '' AND Exists('C:\Program Files\WinFsp\bin\WinFsp-MSIL.dll')">C:\Program Files\WinFsp\bin\WinFsp-MSIL.dll</WinFspMsilDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- SFTP client library -->
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <!-- WinFSP managed bindings (requires WinFSP to be installed) -->
    <Reference Include="WinFsp-MSIL" Condition="'$(WinFspMsilDll)' != ''">
      <HintPath>$(WinFspMsilDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
